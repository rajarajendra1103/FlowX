---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Tier 12 Planner Widgets & Playground">
  <style is:global>
    @import '../../../../packages/ui/src/styles/index.css';

    .payload-logger {
      background: #0f172a;
      color: #38bdf8;
      font-family: var(--flowx-font-mono);
      font-size: 0.85rem;
      padding: 1.25rem 1.5rem;
      border-radius: var(--flowx-radius-md);
      margin-top: 1rem;
      border: 1px solid var(--flowx-border-color);
      max-height: 200px;
      overflow-y: auto;
    }
    .logger-title {
      color: #94a3b8;
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-bottom: 8px;
    }
    .keyboard-badge {
      display: inline-block;
      padding: 2px 6px;
      border-radius: 4px;
      background: var(--flowx-bg-hover);
      border: 1px solid var(--flowx-border-color);
      font-family: var(--flowx-font-mono);
      font-size: 11px;
    }
  </style>

  <script>
    import '../../../../packages/ui/src/index.ts';
    import '../../../../packages/ui/planner/src/index.ts';

    // Mock endpoint logger setup for playground
    document.addEventListener('DOMContentLoaded', () => {
      const logger = document.getElementById('payload-log-output');
      document.addEventListener('fx-commit', (e: any) => {
        if (logger) {
          const timestamp = new Date().toLocaleTimeString();
          const logItem = `[${timestamp}] ${e.detail.action.toUpperCase()} -> ${JSON.stringify(e.detail.payload)}\n`;
          logger.textContent = logItem + (logger.textContent || '');
        }
      });
    });
  </script>

  <section style="margin-bottom: 2rem;">
    <h1 style="font-size: 2.25rem; font-weight: 800; margin-bottom: 0.5rem; background: linear-gradient(135deg, #3b82f6, #a855f7); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
      Tier 12 Planner Widgets & Playground 📅
    </h1>
    <p style="color: var(--text-muted); font-size: 1.05rem; line-height: 1.6;">
      Substantial, self-contained planner widgets built with the <strong>JSON-island initial state, commit-on-action</strong> pattern. Every drag-and-drop interaction uses the Pointer Events API and features a full keyboard-accessible equivalent.
    </p>
  </section>

  <!-- Interactive Kanban Board Playground -->
  <section class="card">
    <h2 class="card-title">📋 Kanban Task Board & Live fx-post Payload Logger</h2>
    <p class="card-desc">
      Drag cards across columns using Pointer Events or test keyboard accessibility: Focus a card with <span class="keyboard-badge">Tab</span>, press <span class="keyboard-badge">Space</span> to pick up, move with <span class="keyboard-badge">&larr; / &rarr;</span>, and press <span class="keyboard-badge">Enter</span> to drop.
    </p>

    <flowx-kanban commit-url="/api/kanban/move">
      <script type="application/json">
        {
          "columns": [
            { "id": "col-backlog", "title": "Backlog" },
            { "id": "col-in-progress", "title": "In Progress" },
            { "id": "col-review", "title": "In Review" },
            { "id": "col-done", "title": "Completed" }
          ],
          "cards": [
            { "id": "c-101", "columnId": "col-backlog", "title": "Refactor CSS Custom Properties", "description": "Ensure token references across all Tiers", "tag": "Core", "tagColor": "#2563eb" },
            { "id": "c-102", "columnId": "col-in-progress", "title": "Build Kanban Accessibility Suite", "description": "Keyboard-only task movement & ARIA live region", "tag": "A11y", "tagColor": "#10b981" },
            { "id": "c-103", "columnId": "col-review", "title": "Gantt Chart SVG Connector Lines", "description": "Render dependency arrows between tasks", "tag": "Planner", "tagColor": "#a855f7" }
          ]
        }
      </script>
    </flowx-kanban>

    <div class="payload-logger">
      <div class="logger-title">Live Payload Log (Mock fx-post Server Receiver)</div>
      <pre id="payload-log-output" style="margin: 0;">Waiting for card movements or user commits...</pre>
    </div>
  </section>

  <!-- Calendar Showcase -->
  <section class="card">
    <h2 class="card-title">📅 Interactive Calendar Widget</h2>
    <p class="card-desc">Month/Week/Day views reading from JSON islands, with click-to-create modals and Pointer Events date dragging.</p>

    <flowx-calendar commit-url="/api/calendar/commit">
      <script type="application/json">
        [
          { "id": "ev-101", "title": "Team Sprint Review", "start": "2026-07-28", "color": "#2563eb" },
          { "id": "ev-102", "title": "Design Tokens Audit", "start": "2026-07-30", "color": "#10b981" }
        ]
      </script>
    </flowx-calendar>
  </section>

  <!-- Gantt Chart Showcase -->
  <section class="card">
    <h2 class="card-title">📊 Gantt Chart & Dependency Editor</h2>
    <p class="card-desc">Task bars with SVG dependency arrows, drag-to-resize/reschedule, and keyboard duration adjustments.</p>

    <flowx-gantt-chart commit-url="/api/gantt/update">
      <script type="application/json">
        [
          { "id": "g-1", "name": "Architecture Design", "startOffset": 1, "duration": 4 },
          { "id": "g-2", "name": "UI Component Engine", "startOffset": 5, "duration": 5, "dependencies": ["g-1"] },
          { "id": "g-3", "name": "Planner Tier 12", "startOffset": 6, "duration": 6, "dependencies": ["g-1"] },
          { "id": "g-4", "name": "Release Launch", "startOffset": 12, "duration": 2, "dependencies": ["g-2", "g-3"] }
        ]
      </script>
    </flowx-gantt-chart>
  </section>

  <!-- Scheduler Showcase -->
  <section class="card">
    <h2 class="card-title">⏱️ Resource Scheduler Grid</h2>
    <p class="card-desc">Resource-by-time-slot matrix for assigning staff/rooms across hourly slots.</p>

    <flowx-scheduler slots-count="7" commit-url="/api/scheduler/assign">
      <script type="application/json">
        {
          "resources": [
            { "id": "res-1", "name": "Sarah Connor", "role": "Lead Architect" },
            { "id": "res-2", "name": "Marcus Wright", "role": "Frontend Engineer" },
            { "id": "res-3", "name": "Kyle Reese", "role": "QA Specialist" }
          ],
          "allocations": [
            { "id": "a-10", "resourceId": "res-1", "slot": 1, "title": "System Design", "color": "#a855f7" },
            { "id": "a-11", "resourceId": "res-2", "slot": 3, "title": "Kanban Polish", "color": "#2563eb" }
          ]
        }
      </script>
    </flowx-scheduler>
  </section>

  <!-- Client-Only Whiteboard Showcase -->
  <section class="card">
    <h2 class="card-title">🎨 Freeform Whiteboard Surface</h2>
    <p class="card-desc">Client-only HTML5 Canvas drawing & sticky-notes surface. State serializes to JSON on draw/edit.</p>

    <flowx-whiteboard commit-url="/api/whiteboard/save">
      <script type="application/json">
        {
          "strokes": [],
          "notes": [
            { "id": "sn-1", "x": 60, "y": 40, "text": "FlowX Tier 12 Planner Architecture", "color": "#fef08a" }
          ]
        }
      </script>
    </flowx-whiteboard>
  </section>
</Layout>
