    const navBtns = document.querySelectorAll('.nav-btn');
    const controlsSec = document.getElementById('controls-section');
    const container = document.getElementById('component-container');
    const codeSnippet = document.getElementById('code-snippet');
    
    let activeKey = 'btn';
    
    const updateShowcase = () => {
      const config = componentsConfig[activeKey];
      if (!config) return;
      
      controlsSec.innerHTML = '<div class="control-group"></div>';
      const group = controlsSec.querySelector('.control-group');
      
      for (const [attrName, opt] of Object.entries(config.attrs)) {
        const item = document.createElement('div');
        item.className = 'control-item';
        item.innerHTML = `<label>${attrName}</label>`;
        
        let input;
        if (opt.type === 'select') {
          input = document.createElement('select');
          opt.options.forEach(o => {
            const s = document.createElement('option');
            s.value = o;
            s.textContent = o || '(none)';
            if (o === opt.value) s.selected = true;
            input.appendChild(s);
          });
        } else if (opt.type === 'boolean') {
          input = document.createElement('input');
          input.type = 'checkbox';
          input.checked = opt.value;
        } else if (opt.type === 'range') {
          input = document.createElement('input');
          input.type = 'range';
          input.min = opt.min;
          input.max = opt.max;
          input.value = opt.value;
        } else if (opt.type === 'number') {
          input = document.createElement('input');
          input.type = 'number';
          input.value = opt.value;
        } else {
          input = document.createElement('input');
          input.type = 'text';
          input.value = opt.value;
        }
        
        item.appendChild(input);
        group.appendChild(item);
        
        const updateValue = () => {
          if (opt.type === 'boolean') {
            opt.value = input.checked;
          } else if (opt.type === 'range' || opt.type === 'number') {
            opt.value = Number(input.value);
          } else {
            opt.value = input.value;
          }
          renderPreview();
        };
        
        input.addEventListener('change', updateValue);
        input.addEventListener('input', updateValue);
      }
      
      const renderPreview = () => {
        const el = document.createElement(config.tag);
        
        let htmlAttr = '';
        
        for (const [attrName, opt] of Object.entries(config.attrs)) {
          if (opt.type === 'boolean') {
            if (opt.value) {
              el.setAttribute(attrName, '');
              htmlAttr += ` ${attrName}`;
            }
          } else if (opt.value !== '') {
            el.setAttribute(attrName, String(opt.value));
            htmlAttr += ` ${attrName}="${opt.value}"`;
          }
        }
        
        el.innerHTML = config.slot;
        container.innerHTML = '';
        container.appendChild(el);
        
        if (activeKey === 'toast') {
          codeSnippet.textContent = `// Programmatic Toast trigger:\nFlowXToast.show({ message: "Success!", variant: "success" });`;
        } else if (activeKey === 'timeline') {
          codeSnippet.textContent = config.slot;
        } else {
          codeSnippet.textContent = `<${config.tag}${htmlAttr}>\n  ${config.slot}\n</${config.tag}>`;
        }
        
        if (config.setup) {
          config.setup();
        }
      };
      
      renderPreview();
    };
    
    navBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        navBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        activeKey = btn.getAttribute('data-target');
        updateShowcase();
      });
    });
    
    updateShowcase();
