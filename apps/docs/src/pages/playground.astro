---
import Layout from '../layouts/Layout.astro';
import fs from 'fs';
import path from 'path';

// Load FlowX core IIFE bundle at compile time to inject inside sandbox
const pathsToTry = [
  path.resolve(process.cwd(), '../../packages/core/dist/index.global.js'),
  path.resolve(process.cwd(), '../core/dist/index.global.js'),
  path.resolve(process.cwd(), 'packages/core/dist/index.global.js'),
];

let flowxCode = '';
for (const p of pathsToTry) {
  if (fs.existsSync(p)) {
    flowxCode = fs.readFileSync(p, 'utf-8');
    break;
  }
}

// Load FlowX UI IIFE bundle to inject inside sandbox preview
const uiPathsToTry = [
  path.resolve(process.cwd(), '../../packages/ui/dist/flowx-ui.js'),
  path.resolve(process.cwd(), '../ui/dist/flowx-ui.js'),
  path.resolve(process.cwd(), 'packages/ui/dist/flowx-ui.js'),
];

let flowxUiCode = '';
for (const p of uiPathsToTry) {
  if (fs.existsSync(p)) {
    flowxUiCode = fs.readFileSync(p, 'utf-8');
    break;
  }
}

// Load FlowX Charts IIFE bundle to inject inside playground
const chartsPathsToTry = [
  path.resolve(process.cwd(), '../../packages/charts/dist/flowx-charts.global.js'),
  path.resolve(process.cwd(), '../charts/dist/flowx-charts.global.js'),
  path.resolve(process.cwd(), 'packages/charts/dist/flowx-charts.global.js'),
];

let flowxChartsCode = '';
for (const p of chartsPathsToTry) {
  if (fs.existsSync(p)) {
    flowxChartsCode = fs.readFileSync(p, 'utf-8');
    break;
  }
}
---

<Layout title="Interactive Playground">
  <script is:inline set:html={flowxCode}></script>
  <script is:inline set:html={flowxUiCode}></script>
  <script is:inline set:html={flowxChartsCode}></script>
  <section class="card" style="max-width: 100%; margin-bottom: 0;">
    <h2 class="card-title">⚡ Interactive Playground</h2>
    <p class="card-desc">Edit HTML with <code>data-fx-*</code> or <code>fx-*</code> attributes on the left and see the reactive live preview on the right.</p>

    <div class="playground-layout">
      <!-- Editor Column -->
      <div class="editor-pane">
        <div class="pane-header">📝 HTML Editor</div>
        <textarea id="code-editor"></textarea>
      </div>

      <!-- Preview Column -->
      <div class="preview-pane">
        <div class="pane-header">👁️ Live Preview Frame</div>
        <iframe id="preview-iframe"></iframe>
      </div>
    </div>
  </section>

  <!-- Showcase Section -->
  <section class="card" style="max-width: 100%; margin-top: 30px;">
    <h2 class="card-title">🎨 UI Component Showcase</h2>
    <p class="card-desc">Interactive catalog of FlowX custom elements primitives. Select a component, modify properties, and see it render live.</p>

    <div class="showcase-layout">
      <!-- Selector Pane -->
      <div class="showcase-nav">
        <div class="nav-section-label">Tier 1 Primitives</div>
        <button class="nav-btn active" data-target="btn">Button</button>
        <button class="nav-btn" data-target="icon-btn">Icon Button</button>
        <button class="nav-btn" data-target="link">Link</button>
        <button class="nav-btn" data-target="badge">Badge</button>
        <button class="nav-btn" data-target="avatar">Avatar</button>
        <button class="nav-btn" data-target="card">Card</button>
        <button class="nav-btn" data-target="divider">Divider</button>
        <button class="nav-btn" data-target="chip">Chip</button>
        <button class="nav-btn" data-target="alert">Alert</button>
        <button class="nav-btn" data-target="toast">Toast</button>
        <button class="nav-btn" data-target="progress">Progress</button>
        <button class="nav-btn" data-target="spinner">Spinner</button>
        <button class="nav-btn" data-target="skeleton">Skeleton</button>
        <div class="nav-section-label">Tier 2 Interactive</div>
        <button class="nav-btn" data-target="tooltip">Tooltip</button>
        <button class="nav-btn" data-target="popover">Popover</button>
        <button class="nav-btn" data-target="dropdown">Dropdown</button>
        <button class="nav-btn" data-target="accordion">Accordion</button>
        <button class="nav-btn" data-target="tabs">Tabs</button>
        <button class="nav-btn" data-target="breadcrumb">Breadcrumb</button>
        <button class="nav-btn" data-target="pagination">Pagination</button>
        <button class="nav-btn" data-target="stepper">Stepper</button>
        <button class="nav-btn" data-target="timeline">Timeline</button>
        <div class="nav-section-label">Tier 3 Forms</div>
        <button class="nav-btn" data-target="fx-input">Input</button>
        <button class="nav-btn" data-target="fx-textarea">Textarea</button>
        <button class="nav-btn" data-target="fx-checkbox">Checkbox</button>
        <button class="nav-btn" data-target="fx-switch">Switch</button>
        <button class="nav-btn" data-target="fx-radio">Radio Group</button>
        <button class="nav-btn" data-target="fx-select">Select</button>
        <button class="nav-btn" data-target="fx-slider">Slider</button>
        <button class="nav-btn" data-target="fx-rating">Rating</button>
        <button class="nav-btn" data-target="fx-otp">OTP Input</button>
        <button class="nav-btn" data-target="fx-autocomplete">Autocomplete</button>
        <button class="nav-btn" data-target="fx-signup-form">🚀 Signup Form Demo</button>
        <div class="nav-section-label">Tier 5 Server Data</div>
        <button class="nav-btn" data-target="fx-data-table">Data Table</button>
        <button class="nav-btn" data-target="fx-data-grid">Data Grid</button>
        <button class="nav-btn" data-target="fx-search">Debounced Search</button>
        <button class="nav-btn" data-target="fx-export">Export Button</button>
        <button class="nav-btn" data-target="fx-print">Print Button</button>
        <button class="nav-btn" data-target="fx-grid-demo">⚡ Server Data Grid Showcase</button>
        <div class="nav-section-label">Tier 6 Overlays</div>
        <button class="nav-btn" data-target="fx-modal">Modal</button>
        <button class="nav-btn" data-target="fx-sheet">Sheet</button>
        <button class="nav-btn" data-target="fx-bottom-sheet">Bottom Sheet</button>
        <button class="nav-btn" data-target="fx-confirm">Confirm Dialog</button>
        <button class="nav-btn" data-target="fx-lightbox">Lightbox</button>
        <button class="nav-btn" data-target="fx-delete-demo">🚀 Gated Delete Showcase</button>
        <div class="nav-section-label">Tier 7 Navigation</div>
        <button class="nav-btn" data-target="fx-navbar">Navbar</button>
        <button class="nav-btn" data-target="fx-sidebar">Sidebar</button>
        <button class="nav-btn" data-target="fx-dock">Mac Dock</button>
        <button class="nav-btn" data-target="fx-bottom-nav">Bottom Nav</button>
        <button class="nav-btn" data-target="fx-menu">Menu & Items</button>
        <button class="nav-btn" data-target="fx-app-shell">🚀 Full App Shell Showcase</button>
        <div class="nav-section-label">Tier 8 Charts & Dashboard</div>
        <button class="nav-btn" data-target="fx-bar-chart">Bar Chart</button>
        <button class="nav-btn" data-target="fx-line-chart">Line Chart</button>
        <button class="nav-btn" data-target="fx-pie-chart">Pie Chart</button>
        <button class="nav-btn" data-target="fx-gauge">Gauge Dial</button>
        <button class="nav-btn" data-target="fx-kpi-card">KPI Card</button>
        <button class="nav-btn" data-target="fx-live-dashboard">🚀 Live SSE Dashboard Showcase</button>
        <div class="nav-section-label">Tier 9 Media & Viewers</div>
        <button class="nav-btn" data-target="fx-image">Image + Blur</button>
        <button class="nav-btn" data-target="fx-gallery">Image Gallery</button>
        <button class="nav-btn" data-target="fx-carousel">Carousel</button>
        <button class="nav-btn" data-target="fx-video-player">Video Player</button>
        <button class="nav-btn" data-target="fx-markdown-viewer">Markdown Viewer</button>
        <button class="nav-btn" data-target="fx-code-viewer">Code Viewer</button>
      </div>

      <!-- Controls & Preview Panel -->
      <div class="showcase-panel">
        <div id="controls-section">
          <!-- Dynamically populated controls -->
        </div>

        <div id="preview-section">
          <div class="preview-header">Live Component Render</div>
          <div id="component-container">
            <!-- Custom Element rendered here -->
          </div>
          <pre id="code-snippet"></pre>
        </div>
      </div>
    </div>
  </section>
</Layout>

<!-- Load CodeMirror v5 -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.13/codemirror.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.13/theme/dracula.min.css">
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.13/codemirror.min.js"></script>
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.13/mode/xml/xml.min.js"></script>
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.13/mode/javascript/javascript.min.js"></script>
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.13/mode/css/css.min.js"></script>
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.13/mode/htmlmixed/htmlmixed.min.js"></script>

<!-- Pass compiled core FlowX and UI code to client runtime -->
<script is:inline define:vars={{ flowxCode, flowxUiCode }}>
  window.FLOWX_CORE_CODE = flowxCode;
  window.FLOWX_UI_CODE = flowxUiCode;
</script>

<script>
  // Register all Custom Elements in docs parent window for the Showcase preview panel
  import '../../../../packages/ui/src/index';
</script>

<script is:inline>
  const defaultHtml = `<div class="sandbox-container">
  <h3>⚡ FlowX AJAX Sandbox</h3>
  <p>Modify these attributes and click the button!</p>
  
  <flowx-button 
    variant="primary" 
    size="md"
    fx-get="/api/time" 
    fx-target="#response-box" 
    fx-swap="innerHTML"
  >
    Get Server Time
  </flowx-button>

  <div id="response-box" style="margin-top: 15px;">
    Click the button to query...
  </div>
</div>`;

  window.addEventListener('DOMContentLoaded', () => {
    // 1. Setup Editor & Preview Iframe
    const textarea = document.getElementById('code-editor');
    const iframe = document.getElementById('preview-iframe');

    if (textarea && iframe) {
      const editor = CodeMirror.fromTextArea(textarea, {
        lineNumbers: true,
        mode: 'htmlmixed',
        theme: 'dracula',
        tabSize: 2,
      });

      editor.setValue(defaultHtml);

      const updatePreview = () => {
        const value = editor.getValue();
        const doc = iframe.contentDocument || iframe.contentWindow.document;
        
        doc.open();
        doc.write(`
          <!DOCTYPE html>
          <html>
          <head>
            <style>
              body {
                font-family: system-ui, -apple-system, sans-serif;
                color: #e6edf3;
                background: #0d1117;
                margin: 1.5rem;
              }
              .sandbox-container {
                border: 1px solid rgba(255,255,255,0.08);
                border-radius: 8px;
                padding: 1.5rem;
                background: rgba(255,255,255,0.01);
              }
              h3 {
                margin-top: 0;
                color: #58a6ff;
              }
              #response-box {
                padding: 0.75rem;
                background: rgba(0,0,0,0.2);
                border: 1px solid rgba(255,255,255,0.08);
                border-radius: 6px;
                color: #8b949e;
                font-size: 0.9rem;
              }
            </style>
          </head>
          <body>
            ${value}
            
            <!-- Inject local FlowX Core & UI runtimes -->
            <script>${window.FLOWX_CORE_CODE || ''}<\/script>
            <script>${window.FLOWX_UI_CODE || ''}<\/script>
            
            <!-- Mock sandbox requests -->
            <script>
              const originFetch = window.fetch;
              window.fetch = async (url, options) => {
                if (url.includes('/api/time')) {
                  return new Response('🕒 Mocked time: ' + new Date().toLocaleTimeString(), {
                    status: 200,
                    headers: { 'Content-Type': 'text/plain' }
                  });
                }
                return originFetch(url, options);
              };
            <\/script>
          </body>
          </html>
        `);
        doc.close();
      };

      editor.on('change', () => updatePreview());
      updatePreview();
    }

    // 2. Setup Components Showcase Tab Panel
    const componentsConfig = {
      btn: {
        tag: 'flowx-button',
        attrs: {
          variant: { type: 'select', options: ['primary', 'secondary', 'ghost', 'danger'], value: 'primary' },
          size: { type: 'select', options: ['sm', 'md', 'lg'], value: 'md' },
          disabled: { type: 'boolean', value: false },
          loading: { type: 'boolean', value: false }
        },
        slot: 'Click Me'
      },
      'icon-btn': {
        tag: 'flowx-icon-button',
        attrs: {
          variant: { type: 'select', options: ['primary', 'secondary', 'ghost', 'danger'], value: 'primary' },
          size: { type: 'select', options: ['sm', 'md', 'lg'], value: 'md' },
          round: { type: 'boolean', value: false },
          disabled: { type: 'boolean', value: false },
          loading: { type: 'boolean', value: false },
          'aria-label': { type: 'text', value: 'Search Button' }
        },
        slot: '🔍'
      },
      link: {
        tag: 'flowx-link',
        attrs: {
          href: { type: 'text', value: 'https://example.com' },
          target: { type: 'select', options: ['', '_blank', '_self'], value: '_blank' }
        },
        slot: 'Search Engine'
      },
      badge: {
        tag: 'flowx-badge',
        attrs: {
          variant: { type: 'select', options: ['neutral', 'info', 'success', 'warning', 'error'], value: 'info' },
          size: { type: 'select', options: ['sm', 'md'], value: 'md' }
        },
        slot: 'New Badge'
      },
      avatar: {
        tag: 'flowx-avatar',
        attrs: {
          name: { type: 'text', value: 'Jane Smith' },
          src: { type: 'text', value: '' }
        },
        slot: ''
      },
      card: {
        tag: 'flowx-card',
        attrs: {},
        slot: '<div slot="header">Card Header</div><p>This is a standard card component containing multiple sections.</p><div slot="footer">Card Footer</div>'
      },
      divider: {
        tag: 'flowx-divider',
