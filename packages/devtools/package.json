{
  "name": "@flowx/devtools",
  "version": "0.1.0",
  "description": "FlowX interactive developer tools panel and debugger",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/flowx-devtools.js",
  "jsdelivr": "./dist/flowx-devtools.js",
  "browser": "./dist/flowx-devtools.js",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./dist/*": "./dist/*"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint \"src/**/*.ts\""
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "tsup": "^8.1.0"
  }
}
