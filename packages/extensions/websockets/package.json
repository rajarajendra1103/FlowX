{
  "name": "@flowx/websockets",
  "version": "0.1.0",
  "description": "WebSocket extension for FlowX",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/index.global.js",
  "jsdelivr": "./dist/index.global.js",
  "browser": "./dist/index.global.js",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./dist/*": "./dist/*"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint \"src/**/*.ts\""
  },
  "dependencies": {
    "@flowx/core": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "tsup": "^8.1.0"
  }
}
